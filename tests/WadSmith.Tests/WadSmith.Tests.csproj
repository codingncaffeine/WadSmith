<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 builds its own app host. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>WadSmith.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WadSmith.Core\WadSmith.Core.csproj" />
    <ProjectReference Include="..\..\src\WadSmith.Cli\WadSmith.Cli.csproj" />
    <ProjectReference Include="..\..\src\WadSmith.Editor\WadSmith.Editor.csproj" />
    <ProjectReference Include="..\..\src\WadSmith\WadSmith.csproj" />
  </ItemGroup>

</Project>
