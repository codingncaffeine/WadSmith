<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders screens of the application to PNG files on Avalonia's headless platform, so a layout
       can be looked at without opening a window on anybody's desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>WadSmith.Capture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WadSmith\WadSmith.csproj" />
  </ItemGroup>

</Project>
