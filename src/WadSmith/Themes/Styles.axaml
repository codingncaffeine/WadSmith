<!-- Control looks of the Forge theme. Every value comes from Tokens.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>

    <!-- Small uppercase section labels, as Emutastic's panels have them. -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Engraved-metal buttons: raised charcoal, black chisel border, a hairline of light on top. -->
    <Style Selector="Button.metal">
        <Setter Property="Background" Value="{DynamicResource Brush.Metal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Metal.Chisel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.metal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Metal.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Metal.Chisel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.metal:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Metal.Recessed}" />
    </Style>

    <!-- Segmented choice (one of several views): metal segments, the chosen one lit in the accent. -->
    <Style Selector="ToggleButton.segment">
        <Setter Property="Background" Value="{DynamicResource Brush.Metal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Metal.Chisel}" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="11,6" />
    </Style>
    <!-- The plan's tools: a column down its left edge (§3.3), each button as wide as the widest. -->
    <Style Selector="ToggleButton.segment.tool">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.segment.tool.first">
        <Setter Property="CornerRadius" Value="4,4,0,0" />
    </Style>
    <Style Selector="ToggleButton.segment.tool.last">
        <Setter Property="CornerRadius" Value="0,0,4,4" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Presets beside an Inspector number (D27): a row of small segments sharing the panel's width. -->
    <Style Selector="ToggleButton.segment.preset">
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment.first">
        <Setter Property="CornerRadius" Value="4,0,0,4" />
    </Style>
    <Style Selector="ToggleButton.segment.last">
        <Setter Property="CornerRadius" Value="0,4,4,0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Metal.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Metal.Chisel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Metal.Chisel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Ink}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
    </Style>

    <!-- The one main action on a screen: hellfire orange. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Ink}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
    </Style>

    <!-- Caption buttons: quiet until pointed at; close turns red. -->
    <Style Selector="Button.caption">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <!-- The guided first map points at the control its open step is about: an outline in the accent colour
         on its own border width, with its words in the accent colour, so nothing around it moves. -->
    <Style Selector=":is(Button).guide /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector=":is(Button).guide:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Ink}" />
    </Style>
    <Style Selector="SplitButton.guide /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
</Styles>
