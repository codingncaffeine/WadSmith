<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WadSmith.App.ViewModels"
             xmlns:canvas="using:WadSmith.App.Canvas"
             xmlns:threeD="using:WadSmith.App.ThreeD"
             x:Class="WadSmith.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    </UserControl.KeyBindings>

    <UserControl.DataTemplates>
        <!-- A shelf: search, a group, and the pictures to drag onto the map. -->
        <DataTemplate DataType="vm:ShelfViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <TextBox Text="{Binding Search}" PlaceholderText="Search by name…" />
                <ComboBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedIndex="{Binding Group}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding Note}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,6" />
                <ScrollViewer Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ShelfTile">
                                <Border Width="92" Margin="0,0,6,6" Padding="4" CornerRadius="4" Background="{DynamicResource Brush.Surface1}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Cursor="Hand"
                                        ToolTip.Tip="{Binding Tooltip}" PointerPressed="OnShelfTilePressed">
                                    <StackPanel Spacing="3">
                                        <Border Height="64" Background="#0A0708" CornerRadius="3" ClipToBounds="True">
                                            <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapInterpolationMode="None" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="50,*,30">
        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TopBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,0">
                <Button Classes="metal" Content="‹ Start" Command="{Binding CloseCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Back to the start screen. Your changes are already kept." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center" Spacing="6">
                    <Image Source="/Assets/icon.png" Width="24" Height="24" />
                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="·" Classes="secondary" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MapName}" Classes="secondary" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,10,0">
                        <ToggleButton Classes="segment first" Content="Floors" IsChecked="{Binding IsFloors}"
                                      ToolTip.Tip="Shows each area's floor as it looks in the game, lit by its brightness." />
                        <ToggleButton Classes="segment" Content="Ceilings" IsChecked="{Binding IsCeilings}"
                                      ToolTip.Tip="Shows each area's ceiling texture, as if looking up through the map." />
                        <ToggleButton Classes="segment" Content="Heights" IsChecked="{Binding ShowHeights}"
                                      ToolTip.Tip="Colours every area by its floor height, blue for low and red for high, so steps, pits and platforms stand out." />
                        <ToggleButton Classes="segment last" Content="Lines" IsChecked="{Binding IsLines}"
                                      ToolTip.Tip="Shows only the walls, in the colours of the game's automap." />
                    </StackPanel>
                    <ToggleButton Classes="segment first last" Content="3D" IsChecked="{Binding Show3D}" Margin="0,0,10,0"
                                  ToolTip.Tip="Shows the map in 3D beside the plan, from any angle." />
                    <Button Classes="metal" Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" />
                    <Button Classes="metal" Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" />
                    <Button Classes="metal" Content="Keep a version" Command="{Binding KeepVersionCommand}"
                            ToolTip.Tip="Keeps a copy of the map as it is now, with a picture, in the project's versions." />
                    <Button Classes="metal" Content="Preferences" Command="{Binding OpenPreferencesCommand}"
                            ToolTip.Tip="Larger text, tips, the title bar and where your games are (Ctrl+,)." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas and Inspector -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,356">
            <Grid x:Name="MapViews" ColumnDefinitions="*,4,*">
            <Panel>
                <canvas:MapCanvas x:Name="Canvas" Session="{Binding Session}" Mode="{Binding ViewMode}" Tool="{Binding Tool}" />

                <!-- Tools: what a left drag on the plan does. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <ToggleButton Classes="segment first" Content="Select" IsChecked="{Binding IsSelectTool}"
                                  ToolTip.Tip="Click a room, a wall, a corner or a thing to see it in the Inspector; Shift adds or removes (V)." />
                    <ToggleButton Classes="segment" Content="Room" IsChecked="{Binding IsRoomTool}"
                                  ToolTip.Tip="Drag to draw a room. It snaps to the grid and to corners; drawn against or over other rooms, it shares their walls and never removes any (R)." />
                    <ToggleButton Classes="segment last" Content="Door" IsChecked="{Binding IsDoorTool}"
                                  ToolTip.Tip="Click the wall between two rooms to make it a door that opens when used, with the game's door and track textures (D)." />
                </StackPanel>

                <!-- Heights legend: the colour ramp with the lowest and highest floor. -->
                <Border IsVisible="{Binding ShowHeights}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="12,9,12,10"
                        CornerRadius="6" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        ToolTip.Tip="Areas are coloured by floor height: blue for the lowest, red for the highest. The player is 56 units tall and steps up 24.">
                    <StackPanel Width="230" Spacing="5">
                        <TextBlock Text="Floor heights" FontWeight="SemiBold" />
                        <Border Height="12" CornerRadius="3" Background="#0A0708" ClipToBounds="True">
                            <Border x:Name="HeightsRamp" Opacity="0.55" />
                        </Border>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="{Binding HeightsLow}" Classes="secondary" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding HeightsHigh}" Classes="secondary" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding HeightsNote}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Panel>
            <GridSplitter Grid.Column="1" x:Name="Split3D" Background="{DynamicResource Brush.Border.Subtle}" ResizeDirection="Columns" />
            <Panel Grid.Column="2" x:Name="Pane3D">
                <threeD:View3D x:Name="View3D" Session="{Binding Session}" Mode="{Binding CameraMode}"
                               ToolTip.Tip="The map in 3D. Orbit: drag to turn, right-drag to move, scroll to come closer. Fly and Walk: drag to look, WASD to move. Home shows the whole map." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <ToggleButton Classes="segment first" Content="Orbit" IsChecked="{Binding IsOrbit}"
                                  ToolTip.Tip="Turn around the map like a model on a table." />
                    <ToggleButton Classes="segment" Content="Fly" IsChecked="{Binding IsFly}"
                                  ToolTip.Tip="Move freely through the map: drag to look, WASD to move, Q and E to go down and up, Shift for speed." />
                    <ToggleButton Classes="segment last" Content="Walk" IsChecked="{Binding IsWalk}"
                                  ToolTip.Tip="Walk as the player does: eye height, up steps, stopped by walls. Drag to look, WASD to move, Shift to run." />
                </StackPanel>
            </Panel>
            </Grid>
            <GridSplitter Grid.Column="1" Background="{DynamicResource Brush.Border.Subtle}" ResizeDirection="Columns" />
            <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Margin="18,12,18,2">
                    <ToggleButton Classes="segment first" Content="Inspector" IsChecked="{Binding ShowInspector}"
                                  ToolTip.Tip="What you selected and its settings." />
                    <ToggleButton Classes="segment" Content="Textures" IsChecked="{Binding ShowTextures}"
                                  ToolTip.Tip="The game's textures. Drag one onto a wall, a floor or a ceiling." />
                    <ToggleButton Classes="segment" Content="Objects" IsChecked="{Binding ShowObjects}"
                                  ToolTip.Tip="The game's monsters, items and decorations. Drag one onto the map to place it." />
                    <ToggleButton Classes="segment last" Content="Versions" IsChecked="{Binding ShowVersions}"
                                  ToolTip.Tip="Copies of this map WadSmith kept for you. Go back to any of them." />
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding TextureShelf}" IsVisible="{Binding ShowTextures}" Margin="18,8,12,8" />
                <ContentControl Grid.Row="1" Content="{Binding ObjectShelf}" IsVisible="{Binding ShowObjects}" Margin="18,8,12,8" />
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowVersions}">
                    <StackPanel Margin="18,10,18,18" Spacing="10">
                        <TextBlock Text="{Binding VersionsNote}" Classes="secondary" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VersionItem">
                                    <Border Classes="card" Margin="0,0,0,10" Padding="10">
                                        <StackPanel Spacing="6">
                                            <Border Background="#0A0708" CornerRadius="4" Height="150">
                                                <Image Source="{Binding Picture}" Stretch="Uniform" Margin="4" />
                                            </Border>
                                            <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" Classes="secondary" TextWrapping="Wrap" />
                                            <Button Classes="metal" Content="Go back to this version" Command="{Binding GoBackCommand}" HorizontalAlignment="Left"
                                                    ToolTip.Tip="Makes this copy the map again. The map as it is now is kept as a version first, so you can come back to it." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowInspector}">
                    <StackPanel Margin="18,6,18,18">
                        <TextBlock Classes="section" Text="INSPECTOR" />
                        <TextBlock Text="{Binding Inspector.Heading}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Inspector.Summary}" Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Inspector.Rows}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:NumberRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <NumericUpDown Value="{Binding Value}" Increment="{Binding Step}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                       FormatString="0.##" ToolTip.Tip="{Binding Tooltip}" />
                                        <TextBlock Text="{Binding HintText}" Classes="secondary" FontSize="12" Margin="0,3,0,0" IsVisible="{Binding HintText.Length}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:TextRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding Value}" ToolTip.Tip="{Binding Tooltip}" LostFocus="OnTextRowLostFocus" KeyDown="OnTextRowKeyDown" />
                                        <TextBlock Text="{Binding HintText}" Classes="secondary" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" IsVisible="{Binding HintText.Length}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:ChoiceRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding Value}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:HeadingRow">
                                    <TextBlock Classes="section" Text="{Binding Label}" Margin="0,10,0,8" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ActionRow">
                                    <Button Classes="metal" Content="{Binding Label}" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}" HorizontalAlignment="Left" Margin="0,2,0,8" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FlagRow">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,6" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:InfoRow">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10" ToolTip.Tip="{Binding Tooltip}">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip: what is under the pointer, or the coach's next tip; and whether changes are kept. -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding SaveText}" Classes="secondary" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
