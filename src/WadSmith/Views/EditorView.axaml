<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WadSmith.App.ViewModels"
             xmlns:canvas="using:WadSmith.App.Canvas"
             xmlns:threeD="using:WadSmith.App.ThreeD"
             x:Class="WadSmith.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <UserControl.DataTemplates>
        <!-- A shelf: search, a group, and the pictures to drag onto the map. -->
        <DataTemplate DataType="vm:ShelfViewModel">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <TextBox Text="{Binding Search}" PlaceholderText="Search by name…"
                         ToolTip.Tip="Shows only what has these letters in its name, such as “door” or “brown”." />
                <ComboBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedIndex="{Binding Group}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                          ToolTip.Tip="Which group the shelf shows, including what your other games have. Drag anything shown onto the plan or the 3D view." />
                <TextBlock Grid.Row="2" Text="{Binding Note}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,6" />
                <ScrollViewer Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ShelfTile">
                                <Border Width="92" Margin="0,0,6,6" Padding="4" CornerRadius="4" Background="{DynamicResource Brush.Surface1}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Cursor="Hand"
                                        ToolTip.Tip="{Binding Tooltip}" PointerPressed="OnShelfTilePressed" PointerEntered="OnShelfTileEntered">
                                    <StackPanel Spacing="3">
                                        <Border Height="64" Background="#0A0708" CornerRadius="3" ClipToBounds="True">
                                            <Image Source="{Binding Picture}" Stretch="None" RenderOptions.BitmapInterpolationMode="None" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="50,*,Auto,30">
        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TopBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
                <Button Classes="metal" Content="‹ Start" Command="{Binding CloseCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Back to the start screen. Your changes are already kept." />
                <!-- The project and the map: the one part of the bar that gives way, trimmed, so the controls always fit. -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="24" Height="24" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectName}">
                        <Run Text="{Binding ProjectName}" FontWeight="SemiBold" />
                        <Run Text=" · " Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <Run Text="{Binding MapName}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,10,0">
                        <ToggleButton Classes="segment first" Content="Floors" IsChecked="{Binding IsFloors}"
                                      ToolTip.Tip="Shows each area's floor as it looks in the game, lit by its brightness." />
                        <ToggleButton Classes="segment" Content="Ceilings" IsChecked="{Binding IsCeilings}"
                                      ToolTip.Tip="Shows each area's ceiling texture, as if looking up through the map." />
                        <ToggleButton Classes="segment" Content="Heights" Classes.guide="{Binding Marks.Heights}" IsChecked="{Binding ShowHeights}"
                                      ToolTip.Tip="Colours every area by its floor height, blue for low and red for high, so steps, pits and platforms stand out." />
                        <ToggleButton Classes="segment last" Content="Lines" IsChecked="{Binding IsLines}"
                                      ToolTip.Tip="Shows only the walls, in the colours of the game's automap." />
                    </StackPanel>
                    <SplitButton Content="{Binding Faces.Play.Label, StringFormat='▶ {0}'}" Classes.guide="{Binding Marks.Play}" Command="{Binding PlayCommand}" Margin="0,0,10,0" IsEnabled="{Binding !Playing}"
                                 ToolTip.Tip="{Binding Faces.Play.Tip}">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Play from here (where the 3D view stands)" Command="{Binding PlayFromHereCommand}" InputGesture="Shift+F9" />
                                <Separator />
                                <MenuItem Header="{Binding SkillHeaders[0]}" Command="{Binding ChooseSkillCommand}" CommandParameter="0" />
                                <MenuItem Header="{Binding SkillHeaders[1]}" Command="{Binding ChooseSkillCommand}" CommandParameter="1" />
                                <MenuItem Header="{Binding SkillHeaders[2]}" Command="{Binding ChooseSkillCommand}" CommandParameter="2" />
                                <MenuItem Header="{Binding SkillHeaders[3]}" Command="{Binding ChooseSkillCommand}" CommandParameter="3" />
                                <MenuItem Header="{Binding SkillHeaders[4]}" Command="{Binding ChooseSkillCommand}" CommandParameter="4" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ToggleButton Classes="segment first last" Content="{Binding Faces.Player.Label}" IsChecked="{Binding ShowFit}" Margin="0,0,10,0"
                                  ToolTip.Tip="{Binding Faces.Player.Tip}" />
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,10,0">
                        <ToggleButton Classes="segment first" Content="2D" IsChecked="{Binding IsPlanOnly}" Focusable="False"
                                      ToolTip.Tip="The plan alone, from above, with all the room it can have." />
                        <ToggleButton Classes="segment" Content="Split" IsChecked="{Binding IsSplit}" Focusable="False"
                                      ToolTip.Tip="The plan and the 3D view side by side; drag the line between them to share the room. What you select in one is selected in the other." />
                        <ToggleButton Classes="segment last" Content="{Binding Faces.ThreeD.Label}" Classes.guide="{Binding Marks.ThreeD}" IsChecked="{Binding Is3DOnly}" Focusable="False"
                                      ToolTip.Tip="{Binding Faces.ThreeD.Tip}" />
                    </StackPanel>
                    <Button Classes="metal" Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" />
                    <Button Classes="metal" Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" />
                    <Button Classes="metal" Content="Keep a version" Command="{Binding KeepVersionCommand}"
                            ToolTip.Tip="Keeps a copy of the map as it is now, with a picture, in the project's versions." />
                    <Button Classes="metal" Content="Preferences" Classes.guide="{Binding Marks.Preferences}" Command="{Binding OpenPreferencesCommand}"
                            ToolTip.Tip="Larger text, tips, the title bar and where your games are (Ctrl+,)." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas and Inspector -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,356">
            <Grid x:Name="MapViews" ColumnDefinitions="*,4,*">
            <Panel x:Name="PlanPane">
                <canvas:MapCanvas x:Name="Canvas" Session="{Binding Session}" Mode="{Binding ViewMode}" Tool="{Binding Tool}" ShowFit="{Binding ShowFit}" Picks="{Binding Picks}" />

                <!-- Tools: what a left drag on the plan does, in a column down the plan's left edge (§3.3). -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <ToggleButton Classes="segment tool first" Content="{Binding SelectLabel}" IsChecked="{Binding IsSelectTool}"
                                  ToolTip.Tip="{Binding Faces.Select.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Room.Label}" Classes.guide="{Binding Marks.Room}" IsChecked="{Binding IsRoomTool}"
                                  ToolTip.Tip="{Binding Faces.Room.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Door.Label}" Classes.guide="{Binding Marks.Door}" IsChecked="{Binding IsDoorTool}"
                                  ToolTip.Tip="{Binding Faces.Door.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Window.Label}" IsChecked="{Binding IsWindowTool}"
                                  ToolTip.Tip="{Binding Faces.Window.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Teleport.Label}" IsChecked="{Binding IsTeleportTool}"
                                  ToolTip.Tip="{Binding Faces.Teleport.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Light.Label}" Classes.guide="{Binding Marks.Light}" IsChecked="{Binding IsLightTool}"
                                  ToolTip.Tip="{Binding Faces.Light.Tip}" />
                    <ToggleButton Classes="segment tool" Content="{Binding Faces.Stairs.Label}" Classes.guide="{Binding Marks.Stairs}" IsChecked="{Binding IsStairsTool}"
                                  ToolTip.Tip="{Binding Faces.Stairs.Tip}" />
                    <ToggleButton Classes="segment tool last" Content="{Binding Faces.Measure.Label}" IsChecked="{Binding IsMeasureTool}"
                                  ToolTip.Tip="{Binding Faces.Measure.Tip}" />
                    <Button Classes="segment tool first last" Content="{Binding MirrorButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Symmetry: rooms you draw and things you place are repeated about the middle, mirrored or turned, as deathmatch maps are built. The middle is the selection's, or the map's when nothing is selected.">
                        <Button.Flyout>
                            <MenuFlyout Placement="RightEdgeAlignedTop">
                                <MenuItem Header="No mirror" Command="{Binding ChooseMirrorCommand}" CommandParameter="0" />
                                <MenuItem Header="Mirror left–right" Command="{Binding ChooseMirrorCommand}" CommandParameter="1" />
                                <MenuItem Header="Mirror top–bottom" Command="{Binding ChooseMirrorCommand}" CommandParameter="2" />
                                <MenuItem Header="Mirror four ways" Command="{Binding ChooseMirrorCommand}" CommandParameter="3" />
                                <MenuItem Header="Half turn" Command="{Binding ChooseMirrorCommand}" CommandParameter="4" />
                                <MenuItem Header="Quarter turns" Command="{Binding ChooseMirrorCommand}" CommandParameter="5" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- See it in a real map (D28): what the open tool makes, in a game's own map. -->
                    <!-- On a canvas, so its width never widens the tool column. -->
                    <Canvas Height="34" Margin="0,10,0,0" IsVisible="{Binding SeeOne, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Classes="metal" Content="{Binding SeeOne.Title}" Command="{Binding SeeOne.Open}" ToolTip.Tip="{Binding SeeOne.Tip}" />
                    </Canvas>
                </StackPanel>

                <!-- Heights legend: the colour ramp with the lowest and highest floor. -->
                <Border IsVisible="{Binding ShowHeights}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="12,9,12,10"
                        CornerRadius="6" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        ToolTip.Tip="Areas are coloured by floor height: blue for the lowest, red for the highest. The player is 56 units tall and steps up 24.">
                    <StackPanel Width="230" Spacing="5">
                        <TextBlock Text="Floor heights" FontWeight="SemiBold" />
                        <Border Height="12" CornerRadius="3" Background="#0A0708" ClipToBounds="True">
                            <Border x:Name="HeightsRamp" Opacity="0.55" />
                        </Border>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="{Binding HeightsLow}" Classes="secondary" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding HeightsHigh}" Classes="secondary" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding HeightsNote}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Panel>
            <GridSplitter Grid.Column="1" x:Name="Split3D" Background="{DynamicResource Brush.Border.Subtle}" ResizeDirection="Columns" />
            <Panel Grid.Column="2" x:Name="Pane3D">
                <threeD:View3D x:Name="View3D" Session="{Binding Session}" Mode="{Binding CameraMode}" ClassicKeys="{Binding ClassicKeys}"
                               ToolTip.Tip="The map in 3D. Orbit: drag to turn, right-drag to move, scroll to come closer. Fly and Walk: drag to look, WASD to move. Home shows the whole map." />
                <Image Source="{Binding EngineViewPicture}" IsVisible="{Binding EngineView}" Stretch="Uniform" />
                <Border IsVisible="{Binding EngineView}" VerticalAlignment="Bottom" Background="#C0120C0E" Padding="12,8">
                    <TextBlock Text="{Binding EngineViewNote}" Classes="secondary" TextWrapping="Wrap" />
                </Border>
                <ToggleButton Classes="segment first last" Content="Game's view" IsChecked="{Binding EngineView}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                              ToolTip.Tip="GZDoom's own picture from where the 3D view stands (G), drawn on a private screen so nothing opens on your desktop. Takes a few seconds; move the camera for another." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <ToggleButton Classes="segment first" Content="Orbit" IsChecked="{Binding IsOrbit}"
                                  ToolTip.Tip="Turn around the map like a model on a table." />
                    <ToggleButton Classes="segment" Content="Fly" IsChecked="{Binding IsFly}"
                                  ToolTip.Tip="Move freely through the map: drag to look, WASD to move, Q and E to go down and up, Shift for speed." />
                    <ToggleButton Classes="segment last" Content="Walk" Classes.guide="{Binding Marks.Walk}" IsChecked="{Binding IsWalk}"
                                  ToolTip.Tip="Walk as the player does: eye height, up steps, stopped by walls. Drag to look, WASD to move, Shift to run." />
                </StackPanel>
            </Panel>
            <!-- What is this? (D33): what the pointer is over, explained; at the other corner from the Guide. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Explained, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12" Padding="14,10" MaxWidth="380" CornerRadius="6" Background="{DynamicResource Brush.Surface1}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Classes="section" Text="WHAT IS THIS?" />
                    <TextBlock Text="{Binding Explained.Heading}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Explained.Text}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- The first Play (D33): a small card over the top of the map area, once, until closed. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Celebration, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="12,56,12,12" Padding="20,16" MaxWidth="460" CornerRadius="8" Background="{DynamicResource Brush.Surface1}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="FIRST PLAY" />
                    <TextBlock Text="{Binding Celebration.Heading}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Celebration.Text}" TextWrapping="Wrap" />
                    <Button Classes="primary" Content="Carry on" Command="{Binding CloseCelebrationCommand}" HorizontalAlignment="Right" Margin="0,4,0,0"
                            ToolTip.Tip="Closes this card. It comes once; Preferences can turn celebrations off." />
                </StackPanel>
            </Border>
            <!-- The Guide (§3.9): the open step beside the map, never in the way of it. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Guide, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="12" Padding="16,12" MaxWidth="420" CornerRadius="6" Background="{DynamicResource Brush.Surface1}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                <StackPanel DataContext="{Binding Guide}" x:DataType="vm:GuideViewModel" Spacing="6">
                    <TextBlock Classes="section" Text="{Binding StepLabel}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <!-- What WadSmith just refused, said here too: the status bar is far from where the user is looking. -->
                    <TextBlock Text="{Binding Said}" IsVisible="{Binding Said.Length}" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding How}" IsVisible="{Binding How.Length}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Next}" IsVisible="{Binding Finished}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GuideLink">
                                <Button Classes="metal" Content="{Binding Title}" Command="{Binding Open}" ToolTip.Tip="{Binding Tip}" Margin="0,0,8,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The buttons wrap: with a long game name in "See one in …" a row ran off the card and the window (2026-10-12). -->
                    <WrapPanel Margin="0,2,0,0">
                        <Button Classes="metal" Margin="0,0,8,6" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"
                                ToolTip.Tip="The step before this one, to read it again. Your map stays as it is; Skip this step goes forward again." />
                        <Button Classes="metal" Margin="0,0,8,6" Content="{Binding SeeOne.Title}" Command="{Binding SeeOne.Open}" ToolTip.Tip="{Binding SeeOne.Tip}"
                                IsVisible="{Binding SeeOne, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button Classes="metal" Margin="0,0,8,6" Content="Skip this step" Command="{Binding SkipCommand}" IsVisible="{Binding !Finished}"
                                ToolTip.Tip="Goes on to the next step without this one. Your map stays as it is." />
                        <Button Classes="metal" Margin="0,0,8,6" Content="Stop the guide" Command="{Binding StopCommand}" IsVisible="{Binding !Finished}"
                                ToolTip.Tip="Ends the guide; your map stays as it is. The Guide button at the bottom right starts it again." />
                        <Button Classes="primary" Margin="0,0,8,6" Content="Keep going" Command="{Binding StopCommand}" IsVisible="{Binding Finished}"
                                ToolTip.Tip="Closes the guide. Your map is yours to change." />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- Explain this map (D32): what the map is made of, its keys and what each difficulty holds, each with Show. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12,56,12,12" Padding="16,12" Width="400" MaxHeight="560" CornerRadius="6" Background="{DynamicResource Brush.Surface1}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                <Grid DataContext="{Binding Report}" x:DataType="vm:ReportView" RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section" Text="THIS MAP" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="metal" Content="Close" Padding="10,1" Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseReportCommand}"
                                ToolTip.Tip="Closes the explanation. Explain this map in the Inspector, with nothing selected, opens it again." />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ReportSectionView">
                                    <StackPanel Spacing="4" Margin="0,4,0,8">
                                        <TextBlock Classes="section" Text="{Binding Heading}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ReportItem">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <!-- The Balance meter: a half is exactly enough ammunition for the monsters. -->
                                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding HasMeter}" Height="6" MinHeight="6" Margin="0,4,0,2"
                                                                     ToolTip.Tip="The ammunition placed against the monsters' health: the middle is exactly enough, the right end twice that." />
                                                        <Button Grid.Column="1" Classes="metal" Content="Show" Padding="8,1" Margin="8,0,0,0" Command="{Binding Show}"
                                                                IsVisible="{Binding Show, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                ToolTip.Tip="Centres the plan and the 3D view on it." />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- A game's own map opened to learn from (D28): what it shows, the way back, and Remix. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Peek, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="110,12,12,0" Padding="16,12" MaxWidth="560"
                    CornerRadius="6" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="{Binding Peek.Kicker}" />
                    <TextBlock Text="{Binding Peek.Heading}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding Peek.Says}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="primary" Content="Back to your map" Command="{Binding BackFromPeekCommand}"
                                ToolTip.Tip="Closes this map and goes back to yours, as you left it." />
                        <Button Classes="metal" Content="Remix this map" Command="{Binding RemixPeekCommand}"
                                ToolTip.Tip="Makes your own copy of this map to change, as Remix on the start screen does. Your map is kept as it is." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Pre-flight (D25): what would break the game, said before it starts, with the way on; over both views, so the 3D view alone shows it too. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding Preflight, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="110,12,12,0" Padding="16,12" MaxWidth="560"
                    CornerRadius="6" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Preflight}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="Fix them and play" Command="{Binding FixAndPlayCommand}" ToolTip.Tip="Makes the fixes WadSmith knows (each one undoes on its own), then plays." />
                        <Button Classes="metal" Content="Play anyway" Command="{Binding PlayAnywayCommand}" />
                        <Button Classes="metal" Content="Cancel" Command="{Binding CancelPlayCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Background="{DynamicResource Brush.Border.Subtle}" ResizeDirection="Columns" />
            <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Margin="18,12,18,2">
                    <ToggleButton Classes="segment first" Content="Inspector" Classes.guide="{Binding Marks.Inspector}" IsChecked="{Binding ShowInspector}"
                                  ToolTip.Tip="What you selected and its settings." />
                    <ToggleButton Classes="segment" Content="Textures" Classes.guide="{Binding Marks.Textures}" IsChecked="{Binding ShowTextures}"
                                  ToolTip.Tip="The game's textures. Drag one onto a wall, a floor or a ceiling." />
                    <ToggleButton Classes="segment" Content="{Binding Faces.Objects.Label}" Classes.guide="{Binding Marks.Objects}" IsChecked="{Binding ShowObjects}"
                                  ToolTip.Tip="{Binding Faces.Objects.Tip}" />
                    <ToggleButton Classes="segment last" Content="Versions" IsChecked="{Binding ShowVersions}"
                                  ToolTip.Tip="Copies of this map WadSmith kept for you. Go back to any of them." />
                </StackPanel>
                <DockPanel Grid.Row="1" IsVisible="{Binding ShowTextures}" Margin="18,8,12,8">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8"
                          ToolTip.Tip="What new rooms look like: their walls, floor and ceiling, and the doors, stairs and switches made in them. A room's Inspector can take its look too.">
                        <TextBlock Text="New rooms look like" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LookNames}" SelectedIndex="{Binding LookIndex}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <ContentControl Content="{Binding TextureShelf}" />
                </DockPanel>
                <ContentControl Grid.Row="1" Content="{Binding ObjectShelf}" IsVisible="{Binding ShowObjects}" Margin="18,8,12,8" />
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowVersions}">
                    <StackPanel Margin="18,10,18,18" Spacing="10">
                        <TextBlock Text="{Binding VersionsNote}" Classes="secondary" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VersionItem">
                                    <Border Classes="card" Margin="0,0,0,10" Padding="10">
                                        <StackPanel Spacing="6">
                                            <Border Background="#0A0708" CornerRadius="4" Height="150">
                                                <Image Source="{Binding Picture}" Stretch="Uniform" Margin="4" />
                                            </Border>
                                            <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" Classes="secondary" TextWrapping="Wrap" />
                                            <Button Classes="metal" Content="Go back to this version" Command="{Binding GoBackCommand}" HorizontalAlignment="Left"
                                                    ToolTip.Tip="Makes this copy the map again. The map as it is now is kept as a version first, so you can come back to it." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowInspector}">
                    <StackPanel Margin="18,6,18,18">
                        <TextBlock Classes="section" Text="INSPECTOR" />
                        <TextBlock Text="{Binding Inspector.Heading}" FontSize="18" FontWeight="SemiBold" ToolTip.Tip="{Binding Inspector.HeadingTip}" />
                        <TextBlock Text="{Binding Inspector.Summary}" Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Inspector.Rows}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:NumberRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <NumericUpDown Value="{Binding Value}" Increment="{Binding Step}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                       FormatString="0.##" ToolTip.Tip="{Binding Tooltip}" />
                                        <!-- Presets over numbers (D27): the words a player knows, lit while the number is theirs. -->
                                        <ItemsControl ItemsSource="{Binding Presets}" IsVisible="{Binding HasPresets}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:PresetChoice">
                                                    <ToggleButton Classes="segment preset" Classes.first="{Binding IsFirst}" Classes.last="{Binding IsLast}"
                                                                  IsChecked="{Binding IsCurrent}" ToolTip.Tip="{Binding Tooltip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                            <Border Width="5" Height="{Binding PictureHeight}" VerticalAlignment="Bottom" CornerRadius="1"
                                                                    Background="{Binding $parent[ToggleButton].Foreground}" IsVisible="{Binding HasBar}" />
                                                            <Border Width="10" Height="10" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource Brush.Metal.Chisel}" Background="{Binding Swatch}" IsVisible="{Binding HasSwatch}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HintText}" Classes="secondary" FontSize="12" Margin="0,3,0,0" IsVisible="{Binding HintText.Length}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:TextRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding Value}" ToolTip.Tip="{Binding Tooltip}" LostFocus="OnTextRowLostFocus" KeyDown="OnTextRowKeyDown" />
                                        <TextBlock Text="{Binding HintText}" Classes="secondary" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" IsVisible="{Binding HintText.Length}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:ChoiceRow">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding Value}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:HeadingRow">
                                    <TextBlock Classes="section" Text="{Binding Label}" Margin="0,10,0,8" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ActionRow">
                                    <Button Classes="metal" Content="{Binding Label}" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}" HorizontalAlignment="Left" Margin="0,2,0,8" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FlagRow">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" ToolTip.Tip="{Binding Tooltip}" Margin="0,0,0,6" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:InfoRow">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10" ToolTip.Tip="{Binding Tooltip}">
                                        <TextBlock Text="{Binding Label}" Classes="secondary" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2">
        <!-- The elevation profile: the floors and ceilings along the line measured last. -->
        <Border IsVisible="{Binding ShowProfile}" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,170" Margin="12,6,12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Profile" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ProfileText}" Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="metal" Content="Close" Command="{Binding CloseProfileCommand}" Margin="10,0,0,0" ToolTip.Tip="Closes the profile." />
                </Grid>
                <canvas:ProfileView Grid.Row="1" Profile="{Binding Profile}" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- Problems: the live checks, each with Show and, where there is one, a Fix. -->
        <Border IsVisible="{Binding ShowProblems}" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" MaxHeight="190">
            <ScrollViewer Margin="12,8,12,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nothing to fix: the map has none of the problems WadSmith checks for." Classes="secondary" IsVisible="{Binding Problems.Empty}" />
                    <ItemsControl ItemsSource="{Binding Problems.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ProblemRow">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Background="{DynamicResource Brush.Accent}" IsVisible="{Binding IsError}">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" IsVisible="{Binding !IsError}">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Classes="secondary" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Sentence}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="metal" Content="Show" Command="{Binding ShowCommand}" IsVisible="{Binding CanShow}" Margin="10,0,0,0"
                                            ToolTip.Tip="Selects it and brings it into view on the map." />
                                    <Button Grid.Column="3" Classes="metal" Content="{Binding FixLabel}" Command="{Binding FixCommand}" IsVisible="{Binding CanFix}" Margin="6,0,0,0"
                                            ToolTip.Tip="Fixes it, as one step you can undo." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </StackPanel>


        <!-- Status strip: what is under the pointer, or the coach's next tip; the Guide; the problems; whether changes are kept. -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="12,0">
                <TextBlock Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ToggleButton Grid.Column="1" Classes="segment first last" Content="What is this?" IsChecked="{Binding WhatIsThis}" Padding="10,1" Margin="16,2,0,2"
                              ToolTip.Tip="Point at anything on the plan or in the 3D view to read what it is, what it does in the game and how to change it (Shift+F1)." />
                <!-- The Guide (§3.9): its chapters, each a few hands-on minutes on this map. -->
                <Button Grid.Column="2" Classes="metal" Content="Guide" Padding="10,1" Margin="16,2,0,2" VerticalAlignment="Center"
                        ToolTip.Tip="Short hands-on chapters on this map: rooms and heights, doors and keys, lifts and stairs, textures, monsters, lights, secrets, map settings, and classic names for veterans.">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight" ItemsSource="{Binding GuideMenu}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:GuideLink">
                                    <Setter Property="Header" Value="{Binding Title}" />
                                    <Setter Property="Command" Value="{Binding Open}" />
                                    <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton Grid.Column="3" Classes="segment first last" Content="{Binding Problems.Summary}" IsChecked="{Binding ShowProblems}" Padding="10,1" Margin="16,2,0,2"
                              ToolTip.Tip="Things that would break or spoil the map, checked as you work, each with a way to see it and often a one-click fix." />
                <TextBlock Grid.Column="4" Text="{Binding SaveText}" Classes="secondary" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Command palette (Ctrl+K): every action by name, with its shortcut. -->
        <Panel Grid.RowSpan="4" IsVisible="{Binding Palette, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#66000000"
               PointerPressed="OnPaletteBackdropPressed">
            <Border DataContext="{Binding Palette}" x:DataType="vm:CommandPaletteViewModel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,64,16,16"
                    Width="620" MaxHeight="520" CornerRadius="8" Padding="10" Background="{DynamicResource Brush.Surface1}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" PointerPressed="OnPalettePressed">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBox x:Name="PaletteSearch" Text="{Binding Query}" PlaceholderText="Type a command, such as “door” or “play”…" KeyDown="OnPaletteKeyDown"
                             ToolTip.Tip="Type a few letters of what you want to do; the arrows choose, Enter does it, Esc closes. Classic names such as “sector” or “linedef” work too." />
                    <TextBlock Grid.Row="1" Text="Nothing matches. Try another word." Classes="secondary" Margin="6,10" IsVisible="{Binding NothingFound}" />
                    <ListBox x:Name="PaletteList" Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
                             Background="Transparent" Focusable="False" Tapped="OnPaletteTapped"
                             ToolTip.Tip="Click a command to do it.">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorCommand">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Group}" Classes="secondary" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,0" MinWidth="28" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                            IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Panel>
    </Grid>
</UserControl>
