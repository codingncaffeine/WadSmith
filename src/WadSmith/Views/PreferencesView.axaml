<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WadSmith.App.ViewModels"
             x:Class="WadSmith.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </UserControl.KeyBindings>

    <Border Classes="card" Width="600" Padding="26,22" MaxHeight="640">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Classes="title" FontSize="24" Text="Preferences" Margin="0,0,0,14" />
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12">
                    <CheckBox Content="Larger text and controls" IsChecked="{Binding LargeInterface}"
                              ToolTip.Tip="Makes everything a quarter bigger: easier to read on a small or far-away screen, such as a handheld or a TV." />

                    <StackPanel Spacing="2">
                        <CheckBox Content="Use the desktop's own title bar" IsChecked="{Binding UseSystemTitleBar}"
                                  ToolTip.Tip="Your desktop draws the window's title bar and its buttons instead of WadSmith." />
                        <TextBlock Text="Takes effect the next time WadSmith starts." Classes="secondary" FontSize="12" Margin="28,0,0,0" />
                    </StackPanel>

                    <CheckBox Content="Show each game's cover picture" IsChecked="{Binding CoverPictures}"
                              ToolTip.Tip="The start screen fetches each game's cover from its Wikipedia article, once, and keeps it in WadSmith's cache. Off, the game's own title screen is shown instead, and nothing is fetched." />

                    <TextBlock Classes="section" Text="TEACHING" Margin="0,12,0,0" />
                    <StackPanel Spacing="4">
                        <CheckBox Content="Show tips in the status bar" IsChecked="{Binding CoachTips}"
                                  ToolTip.Tip="A short tip at the bottom of the editor about the next thing worth trying. Each one stops once you have done what it teaches." />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0">
                            <Button Classes="metal" Content="Show the tips again" Command="{Binding ShowTipsAgainCommand}"
                                    ToolTip.Tip="Starts the tips again from the first one." />
                            <TextBlock Text="{Binding TipsNote}" Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Invite me to the Guide" IsChecked="{Binding GuidePrompts}"
                              ToolTip.Tip="The Guided first map button on each game of the start screen. The Guide button and Ctrl+K open every chapter either way." />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Tooltips" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{Binding Tooltips}" MinWidth="200"
                                  ToolTip.Tip="How much a tooltip says: all of it, only its first sentence, or none at all. Nothing else changes.">
                            <ComboBoxItem Content="Full" />
                            <ComboBoxItem Content="Brief: the first sentence" />
                            <ComboBoxItem Content="Off" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="Celebrate your firsts" IsChecked="{Binding Celebrations}"
                              ToolTip.Tip="A small card the first time your map comes back from the game. Nothing else changes when it is off." />

                    <CheckBox Content="Play an object's sound when pointing at it on the shelf" IsChecked="{Binding ShelfSounds}"
                              ToolTip.Tip="Pointing at a monster on the Objects shelf plays the sound it makes when it sees you; an item plays its pickup sound. Quietly, and only the last one pointed at." />


                    <TextBlock Classes="section" Text="IF YOU HAVE MAPPED BEFORE" Margin="0,12,0,0" />
                    <CheckBox Content="Show classic names" IsChecked="{Binding ClassicNames}"
                              ToolTip.Tip="Labels use the names of the classic editors and tutorials: sector, linedef, sidedef, vertex, thing, light level, lower unpegged. Every tooltip still gives WadSmith's own name." />
                    <StackPanel Spacing="2">
                        <CheckBox Content="Doom Builder keys" IsChecked="{Binding DoomBuilderKeys}"
                                  ToolTip.Tip="The keys of Ultimate Doom Builder's defaults: W for the 3D view, E S D F to move in it, V L S T to pick only corners, walls, rooms or objects, Ctrl+D to draw, Shift+D for a door, C to select nothing, Ctrl+F9 to play from here." />
                        <TextBlock Text="Every command and its key is in the command palette (Ctrl+K)." Classes="secondary" FontSize="12" Margin="28,0,0,0" />
                    </StackPanel>

                    <TextBlock Classes="section" Text="GAME FOLDERS" Margin="0,12,0,0" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="WadSmith looks in the usual places by itself (Steam, GOG, your games folder). Add a folder here when your games are somewhere else." />
                    <ItemsControl ItemsSource="{Binding GameFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameFolderRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                                    <Button Grid.Column="1" Classes="metal" Content="Remove" Margin="10,0,0,0"
                                            Command="{Binding $parent[UserControl].((vm:PreferencesViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="WadSmith stops looking in this folder. The games in it are not touched." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="metal" Content="Pick a game file…" Command="{Binding AddGameFileCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Point WadSmith at a game file (DOOM2.WAD, a ZIP holding one…). Its folder is looked in, and the folders beside and above it." />
                    <Button Classes="metal" Content="Add a folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Tell WadSmith about a folder that holds your games." />
                    </StackPanel>

                    <TextBlock Classes="section" Text="ABOUT" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Image Source="/Assets/icon.png" Width="104" Height="104" VerticalAlignment="Top" />
                        <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="400">
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="A modern, Linux-native map editor for Doom, Doom II, Heretic, Hexen and Strife, built for GZDoom." />
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Free software under the GNU General Public License, version 3 or later. Your game files are only ever read." />
                            <Button Classes="metal" Content="Project page" Click="OnProjectPage" HorizontalAlignment="Left"
                                    ToolTip.Tip="Opens WadSmith's page on GitHub in your browser." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2" x:Name="Done" Classes="primary" Content="Done" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0,18,0,0"
                    ToolTip.Tip="Close Preferences. Every change is already saved." />
        </Grid>
    </Border>
</UserControl>
