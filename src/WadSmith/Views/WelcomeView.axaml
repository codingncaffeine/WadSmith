<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WadSmith.App.ViewModels"
             x:Class="WadSmith.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="1180" Margin="40,32,40,40" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Image Source="/Assets/icon.png" Width="84" Height="84" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="title" Text="WadSmith" />
                        <TextBlock Classes="secondary" FontSize="15" Text="Build maps for the games you love, then play them in GZDoom." />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Classes="metal" Content="Preferences" Command="{Binding OpenPreferencesCommand}" VerticalAlignment="Top"
                        ToolTip.Tip="Larger text, tips, the title bar and where your games are (Ctrl+,)." />
            </Grid>

            <!-- The one quiet question (§3.2 step 5, D34), asked once. -->
            <Border Classes="card" IsVisible="{Binding AskExperience}" Padding="16,14" Margin="0,22,0,0" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="Have you made Doom maps before?" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Your answer only sets how much WadSmith teaches as you go: tips in the status bar, the Guide's invitations, how long tooltips are and the classic names. The editor is the same either way, and Preferences → Teaching changes any of it later." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="metal" Content="Yes, I have" Command="{Binding AnswerExperienceCommand}" CommandParameter="yes"
                                ToolTip.Tip="Tips and the Guide's invitations off, short tooltips, classic names (sector, linedef, thing). Everything else stays." />
                        <Button Classes="metal" Content="No, I'm new" Command="{Binding AnswerExperienceCommand}" CommandParameter="no"
                                ToolTip.Tip="WadSmith teaches as you go: tips, the Guide and full tooltips, in plain words." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="section" Text="YOUR GAMES" Margin="0,24,0,4" />
            <!-- The question a first map starts with, asked over the games found (D53). -->
            <TextBlock Text="Which base game would you like your map to use?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" IsVisible="{Binding !NoGames}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <TextBlock Classes="secondary" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
                <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding Scanning}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding NoGames}" Padding="14" Margin="0,4,0,14" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding NoGamesHeading}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding NoGamesText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="metal" Classes.primary="{Binding FoldersAdded}" Content="Pick a game file…" Command="{Binding AddGameFileCommand}"
                                ToolTip.Tip="Point WadSmith at DOOM.WAD, DOOM2.WAD, HERETIC.WAD, HEXEN.WAD, STRIFE1.WAD or a ZIP holding one. Its folder is looked in, and the folders beside and above it." />
                        <Button Classes="metal" Content="Add a folder…" Command="{Binding AddFolderCommand}"
                                ToolTip.Tip="Tell WadSmith about a folder that holds your games. The folders beside and above it are looked in too, and inside ZIP files." />
                        <Button Classes="metal" Classes.primary="{Binding !FoldersAdded}" Content="Get Freedoom" Command="{Binding GetFreedoomCommand}" IsEnabled="{Binding !GettingFreedoom}"
                                ToolTip.Tip="Downloads Freedoom from its own release page, checks it, and puts it in WadSmith's games folder." />
                        <ProgressBar Width="180" Minimum="0" Maximum="100" Value="{Binding FreedoomProgress}" IsVisible="{Binding GettingFreedoom}" VerticalAlignment="Center" />
                        <TextBlock Classes="secondary" Text="{Binding FreedoomStatus}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameTileViewModel">
                        <Border Classes="card" Width="300" Margin="0,0,18,18" Padding="12" ToolTip.Tip="{Binding Location}">
                            <StackPanel Spacing="10">
                                <Border CornerRadius="6" ClipToBounds="True" Height="168" Background="#000000">
                                    <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="Remix a map"
                                            ToolTip.Tip="Start from one of this game's own maps. Your game files are never changed; your changes become a project of your own.">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ScrollViewer MaxHeight="440" Width="300">
                                                    <ItemsControl ItemsSource="{Binding Maps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MapChoice">
                                                                <Button Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                        Background="Transparent" Command="{Binding Tile.Remix}" CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="metal" Content="New map" Command="{Binding NewMap}" CommandParameter="{Binding}"
                                            ToolTip.Tip="Start with one lit room and a player start, ready to play." />
                                </StackPanel>
                                <Button Classes="metal" Content="Guided first map · 10 minutes" Command="{Binding GuidedMap}" CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).GuidePrompts}"
                                        ToolTip.Tip="A new map, and seven short steps beside it: a room, a door, a texture, a monster and a weapon, a way out, then Play. You can skip or stop at any time." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="metal" Content="Pick a game file…" Command="{Binding AddGameFileCommand}"
                        ToolTip.Tip="Point WadSmith at a game file (DOOM2.WAD, a ZIP holding one…) it did not find by itself. Its folder is looked in, and the folders beside and above it." />
                <Button Classes="metal" Content="Add a folder…" Command="{Binding AddFolderCommand}"
                        ToolTip.Tip="Tell WadSmith about a folder that holds your games, if it did not find them by itself. The folders beside and above it are looked in too, and inside ZIP files." />
                <Button Classes="metal" Content="Open a project…" Command="{Binding OpenProjectCommand}"
                        ToolTip.Tip="Open a WadSmith project folder." />
            </StackPanel>

            <TextBlock Classes="section" Text="RECENT" Margin="0,28,0,4" IsVisible="{Binding Recent.Count}" />
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentProject">
                        <Button Background="Transparent" HorizontalAlignment="Left" Padding="8,6"
                                Command="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Folder}">
                            <TextBlock Text="{Binding Name}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
