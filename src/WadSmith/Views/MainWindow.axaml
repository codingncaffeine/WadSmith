<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WadSmith.App.ViewModels"
        xmlns:views="using:WadSmith.App.Views"
        x:Class="WadSmith.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="680"
        Icon="/Assets/icon.png"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenPreferencesCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:WelcomeViewModel"><views:WelcomeView /></DataTemplate>
        <DataTemplate DataType="vm:EditorViewModel"><views:EditorView /></DataTemplate>
        <DataTemplate DataType="vm:PreferencesViewModel"><views:PreferencesView /></DataTemplate>
        <DataTemplate DataType="vm:MakeMapViewModel"><views:MakeMapView /></DataTemplate>
    </Window.DataTemplates>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Name="Frame">
        <!-- Large interface (D31) scales everything, title bar included, so nothing is laid out twice. -->
        <LayoutTransformControl x:Name="Scaler">
            <Grid RowDefinitions="Auto,*">
                <!-- The title bar: drag to move, double-click to maximise. -->
                <Border Name="TitleBar" Height="36" Background="{DynamicResource Brush.TopBar}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="/Assets/icon.png" Width="20" Height="20" />
                            <TextBlock Text="{Binding Title}" FontSize="13" Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Name="CaptionButtons" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimise">
                                <Path Data="M 0,5 L 10,5" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.4" Width="10" Height="10" />
                            </Button>
                            <Button Classes="caption" Click="OnToggleMaximize" ToolTip.Tip="Maximise or restore">
                                <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.3" Width="10" Height="10" />
                            </Button>
                            <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close (your changes are already kept)">
                                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.4" Width="10" Height="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Panel Grid.Row="1">
                    <ContentControl Content="{Binding Page}" />
                    <!-- Preferences: a sheet over whatever page is open. -->
                    <Border Background="#B8050304" IsVisible="{Binding Preferences, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding Preferences}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </Grid>
        </LayoutTransformControl>
    </Border>
</Window>
