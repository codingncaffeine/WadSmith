<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not drawing or windows: containers (WAD, PK3, folders), maps in all
       three formats, pictures, sounds, music, game definitions and the asset extractor. No UI
       here, so all of it runs headless in the command-line tool and the tests. -->
  <PropertyGroup>
    <RootNamespace>WadSmith.Core</RootNamespace>
    <!-- Pixel buffers are handed to Skia by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WadSmith.Tests" />
  </ItemGroup>

  <!-- Image codecs (PNG, JPEG, GIF, WebP and their animation frames), the same Skia the app draws with. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <!-- The data folder (game definitions, action tables, UI words) is built into the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\**\*.json">
      <!-- Forward slashes on every platform, so the name is the same on Windows. -->
      <LogicalName>data/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
